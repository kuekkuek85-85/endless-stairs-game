rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{studentId} {
      // 랭킹은 누구나 볼 수 있다
      allow read: if true;

      // 문서 형식 검사 (PRD 6. 부정 기록 최소 방어)
      function validDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['studentId', 'name', 'class', 'bestScore', 'playCount', 'updatedAt'])
          && d.keys().hasAll(['studentId', 'name', 'class', 'bestScore', 'playCount', 'updatedAt'])
          && studentId.matches('^[0-9]{5}$')
          && d.studentId == studentId
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 10
          && d['class'] is int && d['class'] >= 1 && d['class'] <= 15
          && d.bestScore is int && d.bestScore >= 0 && d.bestScore <= 3000
          && d.playCount is int && d.playCount >= 1
          && d.updatedAt == request.time;
      }

      allow create: if validDoc() && request.resource.data.playCount == 1;

      // 갱신은 한 판씩만: playCount +1, bestScore 는 줄어들 수 없음, 반은 바뀌지 않음
      allow update: if validDoc()
        && request.resource.data.playCount == resource.data.playCount + 1
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data['class'] == resource.data['class'];

      // 문서 삭제 금지
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
