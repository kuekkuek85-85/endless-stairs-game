rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{studentId} {
      // 랭킹은 누구나 볼 수 있다
      allow read: if true;

      // 문서 형식 검사 (PRD 6. 부정 기록 최소 방어)
      function validDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['studentId', 'name', 'class', 'bestScore', 'bestAt', 'coins', 'playCount', 'updatedAt'])
          && d.keys().hasAll(['studentId', 'name', 'class', 'bestScore', 'bestAt', 'coins', 'playCount', 'updatedAt'])
          // 학번: 1학년(1) + 반(01~15) + 번호(01~40) — 클라이언트 검증과 같은 범위
          && studentId.matches('^1(0[1-9]|1[0-5])(0[1-9]|[1-3][0-9]|40)$')
          && d.studentId == studentId
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 10
          // 반은 학번 2~3번째 자리에서 나온 값이어야 한다
          && d['class'] is int && d['class'] >= 1 && d['class'] <= 15
          && studentId.matches('^1' + (d['class'] < 10 ? '0' : '') + string(d['class']) + '[0-9]{2}$')
          && d.bestScore is int && d.bestScore >= 0 && d.bestScore <= 3000
          && d.bestAt is timestamp
          && d.coins is int && d.coins >= 0 && d.coins <= 1000000
          && d.playCount is int && d.playCount >= 1
          && d.updatedAt == request.time;
      }

      // 첫 기록: 최고 기록 달성 시각은 지금
      allow create: if validDoc()
        && request.resource.data.playCount == 1
        && request.resource.data.bestAt == request.time;

      // 갱신: bestScore 는 줄어들 수 없고, 반은 바뀌지 않는다.
      // playCount 는 그대로(코인만 정산) 또는 +1(한 판 기록). 코인은 자유롭게 증감(로컬 화폐).
      // bestAt(최초 최고 기록 달성 시각):
      //  - 최고 기록이 갱신되면 지금
      //  - 아니면 기존 값을 그대로 유지(없던 예전 문서는 지금으로 기록 허용)
      allow update: if validDoc()
        && request.resource.data.playCount >= resource.data.playCount
        && request.resource.data.playCount <= resource.data.playCount + 1
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data['class'] == resource.data['class']
        && (request.resource.data.bestScore > resource.data.bestScore
              ? request.resource.data.bestAt == request.time
              : ('bestAt' in resource.data
                    ? request.resource.data.bestAt == resource.data.bestAt
                    : request.resource.data.bestAt == request.time));

      // 문서 삭제 금지
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
